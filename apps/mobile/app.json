{
  "expo": {
    "name": "Les Trésors de Haute Bretagne",
    "slug": "tresors-haute-bretagne",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": ["**/*"],
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#8BC34A"
    },
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.tresorshautebretagne.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#8BC34A"
      },
      "package": "com.tresorshautebretagne.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Les Trésors de Haute Bretagne utilise ta position pour vérifier que tu es bien sur place."
        }
      ]
    ],
    "scheme": "tresors"
  }
}
